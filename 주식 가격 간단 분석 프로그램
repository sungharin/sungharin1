import statistics

prices = [100,102,105,103,110,115,117,120,118]

def analyze(prices):

    avg = statistics.mean(prices)
    high = max(prices)
    low = min(prices)

    trend = "상승"
    if prices[-1] < prices[0]:
        trend = "하락"

    print("가격 데이터:", prices)
    print("평균 가격:", avg)
    print("최고 가격:", high)
    print("최저 가격:", low)
    print("전체 추세:", trend)

def moving_average(prices, window=3):

    ma = []

    for i in range(len(prices)-window+1):
        avg = sum(prices[i:i+window]) / window
        ma.append(avg)

    return ma

def main():
    analyze(prices)

    print("\n이동 평균:")
    print(moving_average(prices))

main()
